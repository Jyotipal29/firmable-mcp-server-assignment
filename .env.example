# Postgres connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgres://mcp:mcp@localhost:5432/account_intelligence

# HTTP port the MCP server listens on
PORT=3001

# Base URL used to build export download links (change if running behind a tunnel/host)
EXPORT_BASE_URL=http://localhost:3001

# Static API key clients must send as: Authorization: Bearer <API_KEY>
API_KEY=dev-local-api-key-change-me

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# development | production
NODE_ENV=development
