{
  "name": "firmable-mcp-server",
  "version": "1.0.0",
  "description": "Account Intelligence Platform - MCP server exposing company/contact search, enrichment, and export tools",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/seed/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "wait-for-db": "node scripts/wait-for-db.js",
    "setup": "npm run docker:up && npm run wait-for-db && npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jyotipal29/firmable-mcp-server-assignment.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Jyotipal29/firmable-mcp-server-assignment/issues"
  },
  "homepage": "https://github.com/Jyotipal29/firmable-mcp-server-assignment#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
